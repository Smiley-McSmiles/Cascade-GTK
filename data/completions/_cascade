#compdef cascade
# zsh completion for cascade (generated by tools/gen_completions.py)

_cascade() {
    local -a commands
    commands=(
        'add:add magnet links, .torrent files or URLs'
        'blocklist:reload the IP blocklist now'
        'config:show every setting (optionally one page or key)'
        'create:create a .torrent file'
        'daemon:run the Cascade service in the foreground'
        'export:save the .torrent file'
        'files:list files, or set their priorities'
        'get:print settings'
        'gui:open the GTK app (optionally adding magnet links, URLs or .torrent files)'
        'info:everything about one torrent'
        'interfaces:network interfaces you can bind to (net.interface)'
        'label:set the label of torrents ("" removes it)'
        'labels:list, create or remove labels'
        'limit:per-torrent speed and connection limits (0 = default/unlimited)'
        'list:list torrents'
        'log:show the service log'
        'magnet:print the magnet link'
        'move:move torrents data to another folder'
        'option:per-torrent options - sequential, first_last, super_seeding, ratio_limit, seed_time_limit'
        'pause:pause torrents'
        'peers:connected peers, or connect to one by hand'
        'port:show the listening port, or pick a random one'
        'queue:move torrents in the queue'
        'reannounce:contact the trackers and DHT now'
        'recheck:verify the data'
        'remove:remove torrents'
        'reset:reset every setting to its default'
        'resume:resume torrents'
        'schedule:the weekly speed schedule'
        'set:change settings - cascade set KEY VALUE [KEY VALUE ...]'
        'slow:slow mode (the alternative speed limits)'
        'start:force-start torrents (skip the queue)'
        'status:speeds, port, interface, slow mode and web interface'
        'stop:stop the Cascade service'
        'trackers:list, add or remove trackers'
        'watch:live view of the torrents (Ctrl+C to quit)'
        'webui:the web interface'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'cascade command' commands
        _arguments '*:: :->none' '--help[option]' '--insecure[option]' '--json[option]' '--no-start[option]' '--password[option]' '--url[option]' '--version[option]'
        return
    fi
    case $words[2] in
        add) _alternative 'opts:option:(--first-last --label --path --paused --sequential --skip-check --top)' 'files:file:_files' ;;
        blocklist) : ;;
        config) compadd -- add.extra_trackers add.extra_trackers_enabled add.first_last add.magnet_choose_files add.sequential add.show_dialog add.start_paused add.top_of_queue adv.aio_threads adv.announce_all_tiers adv.announce_all_trackers adv.checking_mem adv.choking adv.connection_speed adv.dht_bootstrap adv.dscp adv.file_pool adv.hashing_threads adv.max_peerlist adv.mixed_mode adv.os_cache adv.outgoing_port adv.outgoing_ports adv.seed_choking adv.validate_https alt.download alt.upload app.autostart app.background app.confirm_remove app.theme automation.on_added automation.on_complete conn.max conn.max_per_torrent conn.slots conn.slots_per_torrent downloads.copy_torrents downloads.copy_torrents_path downloads.incomplete_path downloads.part_extension downloads.preallocate downloads.save_path downloads.use_incomplete ipfilter.enabled ipfilter.source ipfilter.trackers ipfilter.update_days labels log.level net.anonymous net.dht net.encryption net.interface net.ipv6 net.killswitch net.lsd net.natpmp_gateway net.pex net.port net.port_file net.port_mode net.random_max net.random_min net.upnp net.utp notify.finished proxy.host proxy.hostnames proxy.password proxy.peers proxy.port proxy.trackers proxy.type proxy.username queue.enabled queue.ignore_slow queue.max_active queue.max_downloads queue.max_seeds queue.slow_rate sched.enabled sched.grid seed.action seed.idle seed.idle_enabled seed.ratio seed.ratio_enabled seed.time seed.time_enabled speed.download speed.limit_lan speed.overhead speed.upload ui.default_asked ui.sort ui.sort_desc watch.after watch.enabled watch.label watch.path webui.cert webui.enabled webui.host webui.https webui.key webui.local_no_auth webui.password webui.port ;;
        create) _alternative 'opts:option:(--comment --output --piece-size --private --seed --source --tracker --v1 --v2 --web-seed)' 'files:file:_files' ;;
        daemon) compadd -- --detach --quiet ;;
        export) compadd -- --output ;;
        files) compadd -- --set ;;
        get) compadd -- add.extra_trackers add.extra_trackers_enabled add.first_last add.magnet_choose_files add.sequential add.show_dialog add.start_paused add.top_of_queue adv.aio_threads adv.announce_all_tiers adv.announce_all_trackers adv.checking_mem adv.choking adv.connection_speed adv.dht_bootstrap adv.dscp adv.file_pool adv.hashing_threads adv.max_peerlist adv.mixed_mode adv.os_cache adv.outgoing_port adv.outgoing_ports adv.seed_choking adv.validate_https alt.download alt.upload app.autostart app.background app.confirm_remove app.theme automation.on_added automation.on_complete conn.max conn.max_per_torrent conn.slots conn.slots_per_torrent downloads.copy_torrents downloads.copy_torrents_path downloads.incomplete_path downloads.part_extension downloads.preallocate downloads.save_path downloads.use_incomplete ipfilter.enabled ipfilter.source ipfilter.trackers ipfilter.update_days labels log.level net.anonymous net.dht net.encryption net.interface net.ipv6 net.killswitch net.lsd net.natpmp_gateway net.pex net.port net.port_file net.port_mode net.random_max net.random_min net.upnp net.utp notify.finished proxy.host proxy.hostnames proxy.password proxy.peers proxy.port proxy.trackers proxy.type proxy.username queue.enabled queue.ignore_slow queue.max_active queue.max_downloads queue.max_seeds queue.slow_rate sched.enabled sched.grid seed.action seed.idle seed.idle_enabled seed.ratio seed.ratio_enabled seed.time seed.time_enabled speed.download speed.limit_lan speed.overhead speed.upload ui.default_asked ui.sort ui.sort_desc watch.after watch.enabled watch.label watch.path webui.cert webui.enabled webui.host webui.https webui.key webui.local_no_auth webui.password webui.port ;;
        gui) _alternative 'opts:option:(--hidden)' 'files:file:_files' ;;
        info) : ;;
        interfaces) : ;;
        label) compadd -- --to ;;
        labels) compadd -- --add --path --remove ;;
        limit) compadd -- --connections --down --slots --up ;;
        list) compadd -- --filter --label --reverse --sort ;;
        log) compadd -- --lines ;;
        magnet) : ;;
        move) _files ;;
        option) compadd -- --set ;;
        pause) : ;;
        peers) compadd -- --add ;;
        port) compadd -- show random ;;
        queue) compadd -- up down top bottom ;;
        reannounce) : ;;
        recheck) : ;;
        remove) compadd -- --data --yes ;;
        reset) compadd -- --yes ;;
        resume) : ;;
        schedule) compadd -- show set clear on off ;;
        set) compadd -- add.extra_trackers add.extra_trackers_enabled add.first_last add.magnet_choose_files add.sequential add.show_dialog add.start_paused add.top_of_queue adv.aio_threads adv.announce_all_tiers adv.announce_all_trackers adv.checking_mem adv.choking adv.connection_speed adv.dht_bootstrap adv.dscp adv.file_pool adv.hashing_threads adv.max_peerlist adv.mixed_mode adv.os_cache adv.outgoing_port adv.outgoing_ports adv.seed_choking adv.validate_https alt.download alt.upload app.autostart app.background app.confirm_remove app.theme automation.on_added automation.on_complete conn.max conn.max_per_torrent conn.slots conn.slots_per_torrent downloads.copy_torrents downloads.copy_torrents_path downloads.incomplete_path downloads.part_extension downloads.preallocate downloads.save_path downloads.use_incomplete ipfilter.enabled ipfilter.source ipfilter.trackers ipfilter.update_days labels log.level net.anonymous net.dht net.encryption net.interface net.ipv6 net.killswitch net.lsd net.natpmp_gateway net.pex net.port net.port_file net.port_mode net.random_max net.random_min net.upnp net.utp notify.finished proxy.host proxy.hostnames proxy.password proxy.peers proxy.port proxy.trackers proxy.type proxy.username queue.enabled queue.ignore_slow queue.max_active queue.max_downloads queue.max_seeds queue.slow_rate sched.enabled sched.grid seed.action seed.idle seed.idle_enabled seed.ratio seed.ratio_enabled seed.time seed.time_enabled speed.download speed.limit_lan speed.overhead speed.upload ui.default_asked ui.sort ui.sort_desc watch.after watch.enabled watch.label watch.path webui.cert webui.enabled webui.host webui.https webui.key webui.local_no_auth webui.password webui.port ;;
        slow) compadd -- on off toggle ;;
        start) : ;;
        status) : ;;
        stop) : ;;
        trackers) compadd -- --add --remove ;;
        watch) compadd -- --filter --interval --label --reverse --sort ;;
        webui) compadd -- status on off password open ;;
    esac
}

_cascade "$@"
